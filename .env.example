# Neon pooled connection used by the application
DATABASE_URL=""

# Neon direct connection used by Prisma migrations
DIRECT_URL=""

# Initial administrator credentials used only by the Prisma seed
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Auth.js signing secret (generate a unique value per environment)
AUTH_SECRET=""

# Cloudinary product media (server-side only; never prefix API_SECRET with NEXT_PUBLIC_)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
